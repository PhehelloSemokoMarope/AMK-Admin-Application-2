<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FCF9F2">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#FFFFFF"
            android:padding="20dp"
            android:elevation="4dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/btnBack"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="◁ Back"
                android:textColor="#D96C06"
                android:textSize="18sp"
                android:textStyle="bold"
                android:padding="8dp"
                android:layout_marginEnd="12dp"/>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Create Order"
                android:textColor="#1C2841"
                android:textSize="20sp"
                android:textStyle="bold"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <Spinner
                android:id="@+id/spinnerOrderMode"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:background="#FFFFFF"
                android:layout_marginBottom="16dp"/>

            <Spinner
                android:id="@+id/spinnerCustomer"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:background="#FFFFFF"
                android:layout_marginBottom="16dp"/>

            <EditText
                android:id="@+id/inputGarment"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:background="#FFFFFF"
                android:hint="Garment / Item Description *"
                android:padding="16dp"
                android:layout_marginBottom="16dp"/>

            <Spinner
                android:id="@+id/spinnerFabric"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:background="#FFFFFF"
                android:layout_marginBottom="16dp"/>

            <EditText
                android:id="@+id/inputOrderAmount"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:background="#FFFFFF"
                android:hint="Total Amount (R) *"
                android:inputType="numberDecimal"
                android:padding="16dp"
                android:layout_marginBottom="16dp"/>

            <Spinner
                android:id="@+id/spinnerOrderStatus"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:background="#FFFFFF"
                android:layout_marginBottom="32dp"/>

            <Button
                android:id="@+id/btnSaveOrder"
                android:layout_width="match_parent"
                android:layout_height="65dp"
                android:backgroundTint="#1C2841"
                android:text="Save and Finalize Order"
                android:textColor="#FCD34D"
                android:textSize="16sp"
                android:textStyle="bold"/>

        </LinearLayout>
    </LinearLayout>
</ScrollView>