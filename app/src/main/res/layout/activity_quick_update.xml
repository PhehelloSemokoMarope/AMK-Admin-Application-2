<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="#FCF9F2">

    <TextView
        android:id="@+id/btnBack"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="← Back"
        android:textColor="#D96C06"
        android:textSize="16sp"
        android:textStyle="bold"
        android:paddingVertical="8dp"
        android:paddingEnd="12dp"
        android:layout_marginBottom="12dp" />

    <TextView
        android:id="@+id/tvUpdateTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Quick Update"
        android:textColor="#1C2841"
        android:textSize="26sp"
        android:textStyle="bold"
        android:layout_marginBottom="24dp" />

    <EditText
        android:id="@+id/inputUpdateTargetId"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:hint="Item or Order ID"
        android:inputType="text"
        android:background="#FFFFFF"
        android:padding="12dp"
        android:layout_marginBottom="14dp" />

    <EditText
        android:id="@+id/inputUpdateValue"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:hint="Update Value or Status *"
        android:inputType="textCapSentences"
        android:background="#FFFFFF"
        android:padding="12dp"
        android:layout_marginBottom="24dp" />

    <Button
        android:id="@+id/btnSubmitUpdate"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="Save Update"
        android:textColor="#FFFFFF"
        android:backgroundTint="#1C2841" />

</LinearLayout>