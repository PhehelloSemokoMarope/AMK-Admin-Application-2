<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp"
    android:background="#FCF9F2">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="AMK Admin Portal"
        android:textColor="#1C2841"
        android:textSize="32sp"
        android:textStyle="bold"
        android:layout_marginBottom="12dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Please sign in or register a new staff account to continue."
        android:textColor="#555555"
        android:textSize="16sp"
        android:textAlignment="center"
        android:layout_marginBottom="40dp" />

    <Button
        android:id="@+id/btnGoToSignIn"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="Admin Sign In"
        android:textColor="#FFFFFF"
        android:backgroundTint="#1C2841"
        android:layout_marginBottom="16dp" />

    <Button
        android:id="@+id/btnGoToSignUp"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:backgroundTint="#D96C06"
        android:text="Staff Sign Up"
        android:textColor="#1C2841" />

</LinearLayout>