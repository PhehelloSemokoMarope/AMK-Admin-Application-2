<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FCF9F2"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="← Back"
            android:textColor="#D96C06"
            android:textSize="16sp"
            android:textStyle="bold"
            android:paddingVertical="8dp"
            android:paddingEnd="12dp"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Record Measurements"
            android:textColor="#1C2841"
            android:textSize="26sp"
            android:textStyle="bold"
            android:layout_marginBottom="24dp" />

        <EditText
            android:id="@+id/inputMeasureCustomer"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:hint="Customer Name *"
            android:inputType="textPersonName|textCapWords"
            android:background="#FFFFFF"
            android:padding="12dp"
            android:layout_marginBottom="14dp" />

        <EditText
            android:id="@+id/inputChest"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:hint="Chest"
            android:inputType="text"
            android:background="#FFFFFF"
            android:padding="12dp"
            android:layout_marginBottom="14dp" />

        <EditText
            android:id="@+id/inputWaist"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:hint="Waist"
            android:inputType="text"
            android:background="#FFFFFF"
            android:padding="12dp"
            android:layout_marginBottom="14dp" />

        <EditText
            android:id="@+id/inputHips"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:hint="Hips"
            android:inputType="text"
            android:background="#FFFFFF"
            android:padding="12dp"
            android:layout_marginBottom="14dp" />

        <EditText
            android:id="@+id/inputLength"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:hint="Garment Length"
            android:inputType="text"
            android:background="#FFFFFF"
            android:padding="12dp"
            android:layout_marginBottom="14dp" />

        <EditText
            android:id="@+id/inputMeasurementNotes"
            android:layout_width="match_parent"
            android:layout_height="90dp"
            android:hint="Measurement Notes"
            android:gravity="top|start"
            android:inputType="textMultiLine|textCapSentences"
            android:background="#FFFFFF"
            android:padding="12dp"
            android:layout_marginBottom="24dp" />

        <Button
            android:id="@+id/btnSaveMeasurements"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Save Measurements"
            android:textColor="#FFFFFF"
            android:backgroundTint="#1C2841" />

    </LinearLayout>

</ScrollView>