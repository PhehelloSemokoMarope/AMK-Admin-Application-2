<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FCF9F2">

    <!-- Top Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:padding="20dp"
        android:elevation="4dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Dashboard"
                android:textColor="#1C2841"
                android:textSize="24sp"
                android:textStyle="bold"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="AMK Fashion Design System"
                android:textColor="#777777"
                android:textSize="14sp"/>
        </LinearLayout>

        <Button
            android:id="@+id/btnLogout"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:backgroundTint="#FCD34D"
            android:textColor="#1C2841"
            android:textStyle="bold"
            android:text="Logout"/>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Welcome Banner -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#1C2841"
                android:padding="24dp"
                android:orientation="vertical"
                android:layout_marginBottom="16dp">
                <TextView
                    android:id="@+id/tvWelcomeName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Welcome back, Fashion Designer!"
                    android:textColor="#FCD34D"
                    android:textSize="20sp"
                    android:textStyle="bold"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Here's a quick overview of your studio today."
                    android:textColor="#FCF9F2"
                    android:layout_marginTop="4dp"/>
            </LinearLayout>

            <!-- Metric Cards Grid -->
            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="2"
                android:rowCount="2"
                android:alignmentMode="alignMargins"
                android:layout_marginBottom="16dp">

                <androidx.cardview.widget.CardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="8dp"
                    app:cardCornerRadius="8dp"
                    app:cardElevation="2dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp"
                        android:background="@drawable/card_border_left_blue">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="TOTAL ORDERS"
                            android:textColor="#777777"
                            android:textSize="12sp"
                            android:textStyle="bold"/>
                        <TextView
                            android:id="@+id/tvTotalOrders"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textColor="#D96C06"
                            android:textSize="28sp"
                            android:textStyle="bold"/>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="8dp"
                    app:cardCornerRadius="8dp"
                    app:cardElevation="2dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp"
                        android:background="@drawable/card_border_left_blue">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="PENDING PAYMENTS"
                            android:textColor="#777777"
                            android:textSize="12sp"
                            android:textStyle="bold"/>
                        <TextView
                            android:id="@+id/tvPendingPayments"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="R0"
                            android:textColor="#D96C06"
                            android:textSize="28sp"
                            android:textStyle="bold"/>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
            </GridLayout>

            <!-- Full System Navigation Grid -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="System Modules"
                android:textColor="#1C2841"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp"
                android:layout_marginStart="8dp"/>

            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="2"
                android:alignmentMode="alignMargins"
                android:layout_marginBottom="24dp">

                <Button
                    android:id="@+id/btnNavProducts"
                    android:layout_width="9dp"
                    android:layout_height="70dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="4dp"
                    android:backgroundTint="#1C2841"
                    android:text="Products"
                    android:textColor="#FFFFFF" />

                <Button
                    android:id="@+id/btnNavStaff"
                    android:layout_width="0dp"
                    android:layout_height="70dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="4dp"
                    android:backgroundTint="#D96C06"
                    android:textColor="#FFFFFF"
                    android:text="Staff"/>

                <Button
                    android:id="@+id/btnNavCustomers"
                    android:layout_width="0dp"
                    android:layout_height="70dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="4dp"
                    android:backgroundTint="#1C2841"
                    android:textColor="#FFFFFF"
                    android:text="Customers"/>

                <Button
                    android:id="@+id/btnNavOrders"
                    android:layout_width="0dp"
                    android:layout_height="70dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="4dp"
                    android:backgroundTint="#D96C06"
                    android:textColor="#FFFFFF"
                    android:text="Orders"/>

                <Button
                    android:id="@+id/btnNavChats"
                    android:layout_width="0dp"
                    android:layout_height="70dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="4dp"
                    android:backgroundTint="#1C2841"
                    android:textColor="#FFFFFF"
                    android:text="Client Chats"/>

                <Button
                    android:id="@+id/btnNavPayments"
                    android:layout_width="0dp"
                    android:layout_height="70dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="4dp"
                    android:backgroundTint="#D96C06"
                    android:textColor="#FFFFFF"
                    android:text="Payments"/>

                <Button
                    android:id="@+id/btnNavInventory"
                    android:layout_width="0dp"
                    android:layout_height="70dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="4dp"
                    android:backgroundTint="#1C2841"
                    android:textColor="#FFFFFF"
                    android:text="Inventory"/>

                <Button
                    android:id="@+id/btnNavReports"
                    android:layout_width="0dp"
                    android:layout_height="70dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="4dp"
                    android:backgroundTint="#D96C06"
                    android:textColor="#FFFFFF"
                    android:text="Reports"/>

                <Button
                    android:id="@+id/btnNavMeasurements"
                    android:layout_width="0dp"
                    android:layout_height="70dp"
                    android:layout_columnWeight="2"
                    android:layout_margin="4dp"
                    android:backgroundTint="#1C2841"
                    android:textColor="#FFFFFF"
                    android:text="Record Measurements"/>

            </GridLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>